<?xml version="1.0" encoding="utf-8"?>
<!--
  Earbud controls (gesture config): a solid pointing hand with touch ripples either side of its tip.

  24dp viewport, white, tinted per theme in code (ThemeRes.tint).
  Do NOT bake a colour in: on the light theme a baked white glyph is invisible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Hand: a solid pointing hand, bold enough to read at 20dp -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9.5 5.2 A1.75 1.75 0 0 1 13 5.2 V10.8 A1.5 1.5 0 0 1 16 11.2 A1.5 1.5 0 0 1 19 12.2 V16.6 C19 19.6 16.9 21.6 14.2 21.6 H12 C10.4 21.6 9.2 21 8.3 19.9 L4.9 15.8 A1.4 1.4 0 0 1 7.1 14 L9.5 15.8 Z" />
    <!-- Touch ripples -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M6.5 3.2 A4.6 4.6 0 0 0 6.5 7.6 M16 3.2 A4.6 4.6 0 0 1 16 7.6" />
</vector>
