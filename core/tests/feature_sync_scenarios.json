{
 "about": "One rule for every switch that writes to and reads from the buds. Events: tap, ack, report (a read reply or a push), tick, disconnect, reconnect. Output tokens: busy:<id>:on|off, send:<id>:0|1, read:<id>, changed:<id>:<value>, toast:<id>:refused_missing|refused_now|not_changed|no_answer. Timeouts: 3000 ms for an ack or a read reply, 15000 ms after the ack of a write with the restarts trait. Traits: ackOnly (the buds cannot report the value in time), restarts (the write restarts the link). local/FEATURE-SYNC.md has the rules.",
 "scenarios": [
  {
   "name": "plain accept: the value moves once, at the read",
   "init": {
    "24": 0
   },
   "events": [
    {
     "ev": "tap",
     "id": 24,
     "on": true,
     "seq": 5,
     "now": 0,
     "traits": [],
     "expect": [
      "busy:24:on",
      "send:24:1"
     ]
    },
    {
     "ev": "ack",
     "seq": 5,
     "status": 0,
     "now": 50,
     "expect": [
      "read:24"
     ]
    },
    {
     "ev": "report",
     "id": 24,
     "value": 1,
     "now": 120,
     "expect": [
      "changed:24:1",
      "busy:24:off"
     ]
    }
   ]
  },
  {
   "name": "accepted but the buds report the old value: no move, one toast",
   "init": {
    "24": 0
   },
   "events": [
    {
     "ev": "tap",
     "id": 24,
     "on": true,
     "seq": 5,
     "now": 0,
     "traits": [],
     "expect": [
      "busy:24:on",
      "send:24:1"
     ]
    },
    {
     "ev": "ack",
     "seq": 5,
     "status": 0,
     "now": 50,
     "expect": [
      "read:24"
     ]
    },
    {
     "ev": "report",
     "id": 24,
     "value": 0,
     "now": 120,
     "expect": [
      "toast:24:not_changed",
      "busy:24:off"
     ]
    }
   ]
  },
  {
   "name": "late apply (ackOnly): the value moves at the ack, a later read can correct it",
   "init": {
    "6": 0
   },
   "events": [
    {
     "ev": "tap",
     "id": 6,
     "on": true,
     "seq": 7,
     "now": 0,
     "traits": [
      "ackOnly"
     ],
     "expect": [
      "busy:6:on",
      "send:6:1"
     ]
    },
    {
     "ev": "ack",
     "seq": 7,
     "status": 0,
     "now": 60,
     "expect": [
      "changed:6:1",
      "busy:6:off"
     ]
    },
    {
     "ev": "report",
     "id": 6,
     "value": 1,
     "now": 1700,
     "expect": []
    },
    {
     "ev": "report",
     "id": 6,
     "value": 0,
     "now": 2000,
     "expect": [
      "changed:6:0"
     ]
    }
   ]
  },
  {
